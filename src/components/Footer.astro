---
import { SITE, PUBLISHER } from '../config';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <h3>{SITE.name}</h3>
        <p style="margin:0; max-width: 22rem;">{SITE.tagline}</p>
      </div>
      <div>
        <h3>コンテンツ</h3>
        <ul>
          <li><a href={url('/articles/')}>記事一覧</a></li>
          <li><a href={url('/cases/')}>収益化事例カタログ</a></li>
          <li><a href={url('/rankings/')}>手法ランキング</a></li>
          <li><a href={url('/rss.xml')}>RSS</a></li>
        </ul>
      </div>
      <div>
        <h3>サイト情報</h3>
        <ul>
          <li><a href={url('/about/')}>このサイトについて</a></li>
          <li><a href={url('/privacy/')}>プライバシーポリシー</a></li>
          <li><a href={`mailto:${PUBLISHER.contactEmail}`}>お問い合わせ</a></li>
        </ul>
      </div>
    </div>
    <p style="margin: 1.75rem 0 0; font-size: 0.8rem;">
      © {year} {PUBLISHER.name}／{SITE.name}
    </p>
  </div>
</footer>
