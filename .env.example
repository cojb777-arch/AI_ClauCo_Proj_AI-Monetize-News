# ── 週次エージェント（ローカル実行用） ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# 公開URL（Astro のビルドと配信メール内のリンクに使われる）
SITE_URL=https://ai-monetize-news.example.com

# ── ニュースレター送信 ─────────────────────────────────────────
# Worker の /api/newsletter/send を叩くための共有シークレット
NEWSLETTER_SEND_TOKEN=

# ── Cloudflare（wrangler deploy 用。CI では Secrets に入れる） ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
